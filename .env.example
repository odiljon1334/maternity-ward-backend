# Application
NODE_ENV=development
PORT=3001
APP_NAME="Maternity Ward Attendance"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/maternity_ward_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Hikvision Terminal
HIKVISION_WEBHOOK_SECRET=your_hikvision_secret
TIMEZONE=Asia/Tashkent

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Payroll Settings
WEEKLY_LATE_PENALTY_THRESHOLD_MIN=120
LATE_GRACE_PERIOD_MIN=15
OVERTIME_RATE=1.5
