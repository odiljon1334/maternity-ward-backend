# Application
NODE_ENV=development
PORT=3001
APP_NAME="Maternity Ward Attendance"

# Database
# connection_limit  — har bir Prisma instance uchun max ulanish soni
# pool_timeout      — bo'sh connection kutish vaqti (sekund)
# Hisoblash: instances × connection_limit ≤ PostgreSQL max_connections (default=100)
# Misol (8 instance): 8 × 10 = 80 ≤ 100 ✓
DATABASE_URL="postgresql://postgres:password@localhost:5432/maternity_ward_db?connection_limit=10&pool_timeout=30"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Face Match (startup warm-up bilan; 15 soniya CPU inference uchun zaxira)
FACE_MATCH_TIMEOUT_MS=15000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=http://localhost:5001/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# Marketing sahifasidan kelgan "14 kunlik sinov" so'rovlari shu chat'ga yuboriladi
TELEGRAM_LEADS_CHAT_ID=

# Support bot (marketing sayti mijozlari uchun, HR botidan ALOHIDA)
# Yangi bot BotFather orqali yaratiladi, token shu yerga qo'yiladi
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_WEBHOOK_URL=http://localhost:5001/api/v1/support-bot/webhook
SUPPORT_BOT_WEBHOOK_SECRET=
# OpenRouter.ai'dan olingan bepul API key (ish vaqtidan tashqarida AI javob berish uchun)
OPENROUTER_API_KEY=
# Ixtiyoriy: bo'sh qoldirsa TELEGRAM_LEADS_CHAT_ID ishlatiladi
SUPPORT_STAFF_CHAT_ID=
# Ish vaqti (Asia/Tashkent), standart: Dush-Shan 09:00-18:00
SUPPORT_WORK_HOURS_START=09:00
SUPPORT_WORK_HOURS_END=18:00
SUPPORT_WORK_DAYS=1,2,3,4,5,6

# Hikvision Terminal
HIKVISION_WEBHOOK_SECRET=your_hikvision_secret
HIKVISION_WEBHOOK_ENFORCE_SECRET=false
TIMEZONE=Asia/Tashkent

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Payroll Settings
WEEKLY_LATE_PENALTY_THRESHOLD_MIN=120
LATE_GRACE_PERIOD_MIN=15
OVERTIME_RATE=1.5

# Yandex Maps Static API (xarita rasmi uchun)
# https://developer.tech.yandex.ru/ dan oling
YANDEX_MAPS_KEY=your_yandex_maps_api_key

# Web Push (VAPID) — generate with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@your-domain.uz

# Email (Resend) — resend.com dashboard'idan olinadi
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="MaternityCare <onboarding@resend.dev>"


# ─── Sentry (xatoliklarni kuzatish, Faza 3) ────────────────────
# https://sentry.io da bepul akkaunt oching, "Node.js/NestJS" turida
# yangi loyiha yarating va DSN'ni shu yerga qo'ying. Bo'sh qoldirilsa
# Sentry UMUMAN ishga tushmaydi (xavfsiz standart).
SENTRY_DSN=https://253147fffe6d8a6834aa5796eb8d8506@o4512111738290176.ingest.de.sentry.io/4512111770533968
SENTRY_TRACES_SAMPLE_RATE=0
