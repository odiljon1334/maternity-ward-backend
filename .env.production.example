# ─────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT VARIABLES
# Bu faylni .env.production ga ko'chirib to'ldiring
# ─────────────────────────────────────────────────

# Database
POSTGRES_DB=maternity_ward_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE    # <-- o'zgartiring!

DATABASE_URL=postgresql://postgres:STRONG_PASSWORD_HERE@postgres:5432/maternity_ward_db

# JWT — kamida 32 belgili random string
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_STRONG_SECRET_HERE    # <-- o'zgartiring!
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here    # <-- o'zgartiring!

# Frontend URL (CORS uchun)
FRONTEND_URL=https://yourdomain.com       # <-- o'zgartiring!

# Next.js API URL
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1

# Server
PORT=3001
NODE_ENV=production
TIMEZONE=Asia/Tashkent

# Uploads papkasi
UPLOAD_DIR=/app/uploads
