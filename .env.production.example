# ============================================================
# PRODUCTION .env — Contabo VPS uchun
# Bu faylni .env.prod deb nusxa oling va qiymatlarni to'ldiring
# ============================================================

NODE_ENV=production
PORT=5001
APP_NAME="Maternity Ward Attendance"

# ─── Database ────────────────────────────────────────────────
# Kuchli parol: openssl rand -base64 32
POSTGRES_USER=maternity_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=maternity_ward_db
DATABASE_URL="postgresql://maternity_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/maternity_ward_db"

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────
# Yaratish: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ─── Frontend (CORS) ─────────────────────────────────────────
# Vergul bilan bir nechta domain: https://a.com,https://b.com
FRONTEND_URL=https://YOUR_DOMAIN.COM

# ─── Telegram Bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# ─── Hikvision ───────────────────────────────────────────────
HIKCONNECT_HOST=https://open.hikvision.com
HIKCONNECT_APP_KEY=YOUR_APP_KEY
HIKCONNECT_APP_SECRET=YOUR_APP_SECRET
HIKVISION_WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET

# ─── MediaMTX ────────────────────────────────────────────────
MEDIAMTX_HLS_HOST=http://localhost:8888

# ─── File Upload ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Payroll ─────────────────────────────────────────────────
WEEKLY_LATE_PENALTY_THRESHOLD_MIN=120
LATE_GRACE_PERIOD_MIN=15
OVERTIME_RATE=1.5
TIMEZONE=Asia/Tashkent
