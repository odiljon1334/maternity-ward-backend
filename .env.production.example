# ============================================================
# PRODUCTION .env — Contabo VPS uchun
# Bu faylni .env.prod deb nusxa oling va qiymatlarni to'ldiring
# ============================================================

NODE_ENV=production
PORT=5001
APP_NAME="Maternity Ward Attendance"

# ─── Database ────────────────────────────────────────────────
# Kuchli parol: openssl rand -base64 32
POSTGRES_USER=maternity_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=maternity_ward_db
DATABASE_URL="postgresql://maternity_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/maternity_ward_db"

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ─── JWT ─────────────────────────────────────────────────────
# Yaratish: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ─── Frontend (CORS) ─────────────────────────────────────────
# Vergul bilan bir nechta domain: https://a.com,https://b.com
FRONTEND_URL=https://YOUR_DOMAIN.COM

# ─── Telegram Bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Marketing sahifasidan kelgan "14 kunlik sinov" so'rovlari shu chat'ga yuboriladi
TELEGRAM_LEADS_CHAT_ID=

# Support bot (marketing sayti mijozlari uchun, HR botidan ALOHIDA)
# Yangi bot BotFather orqali yaratiladi, token shu yerga qo'yiladi
SUPPORT_BOT_TOKEN=
# OpenRouter.ai'dan olingan bepul API key (ish vaqtidan tashqarida AI javob berish uchun)
OPENROUTER_API_KEY=
# Ixtiyoriy: bo'sh qoldirsa TELEGRAM_LEADS_CHAT_ID ishlatiladi
SUPPORT_STAFF_CHAT_ID=
# Ish vaqti (Asia/Tashkent), standart: Dush-Shan 09:00-18:00
SUPPORT_WORK_HOURS_START=09:00
SUPPORT_WORK_HOURS_END=18:00
SUPPORT_WORK_DAYS=1,2,3,4,5,6

# ─── Hikvision ───────────────────────────────────────────────
HIKCONNECT_HOST=https://open.hikvision.com
HIKCONNECT_APP_KEY=YOUR_APP_KEY
HIKCONNECT_APP_SECRET=YOUR_APP_SECRET
HIKVISION_WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET

# ─── MediaMTX ────────────────────────────────────────────────
MEDIAMTX_HLS_HOST=http://localhost:8888

# ─── File Upload ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Payroll ─────────────────────────────────────────────────
WEEKLY_LATE_PENALTY_THRESHOLD_MIN=120
LATE_GRACE_PERIOD_MIN=15
OVERTIME_RATE=1.5
TIMEZONE=Asia/Tashkent

# ─── Face Match (Qaror 4, o'z serverida — InsightFace) ────────
# Check-in selfie'sini xodim profil rasmi bilan solishtiradi.
# strict (standart)  = xizmat ishlamasa yoki yuz aniqlanmasa ham check-in bloklanadi (fail-closed)
# lenient            = xizmat/yuz aniqlanmasa check-in bloklanmaydi (fail-open, tavsiya etilmaydi)
# Ikkala rejimda ham ANIQ MOS KELMASLIK har doim bloklaydi.
FACE_MATCH_ENABLED=true
FACE_MATCH_MODE=strict
FACE_MATCH_SERVICE_URL=http://face-match:8000
FACE_MATCH_THRESHOLD=0.36
FACE_MATCH_TIMEOUT_MS=6000


# ─── Sentry (xatoliklarni kuzatish, Faza 3) ────────────────────
# https://sentry.io da bepul akkaunt oching. Backend uchun "Node.js/NestJS"
# turida, frontend uchun "Next.js" turida ALOHIDA loyiha yarating (yoki
# ikkalasiga bitta loyiha DSN'ini ham ishlatsa bo'ladi). Bo'sh qoldirilsa
# Sentry UMUMAN ishga tushmaydi (xavfsiz standart).
# — Backend —
SENTRY_DSN=https://253147fffe6d8a6834aa5796eb8d8506@o4512111738290176.ingest.de.sentry.io/4512111770533968
SENTRY_TRACES_SAMPLE_RATE=0
# — Frontend — (NEXT_PUBLIC_* build vaqtida bundle'ga yoziladi, sirli emas)
NEXT_PUBLIC_SENTRY_DSN=https://f1f4d08d0991781c236914f964ecddc1@o4512111738290176.ingest.de.sentry.io/4512111882272848
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Marketing (Faza 4) — Google Tag Manager va Meta Pixel ID
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# — Frontend sourcemap yuklash (ixtiyoriy, Sentry dashboard'da to'g'ri
#   fayl/qator ko'rsatish uchun) — uchalasi ham berilmasa shunchaki
#   o'tkazib yuboriladi, build buzilmaydi.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Avtomatik DB backup — AWS S3 (Faza 3) ─────────────────────
# scripts/backup.sh shu qiymatlardan foydalanadi (cron orqali kunlik
# ishga tushiriladi). IAM foydalanuvchi FAQAT shu bucket'ga PutObject/
# GetObject/DeleteObject/ListBucket huquqiga ega bo'lishi kerak — root
# kalitlari HECH QACHON ishlatilmasin.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BACKUP_BUCKET=maternitycare-db-backups
AWS_DEFAULT_REGION=us-east-1
BACKUP_RETENTION_DAYS=30
