# ============================================================
# .env.prod — VPS ga nusxa olib to'ldiring
# ============================================================

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
APP_NAME="Maternity Ward Attendance"

# ─── Domain ──────────────────────────────────────────────────
# Frontend URL (CORS uchun)
FRONTEND_URL=https://YOUR_DOMAIN.COM
# API URL (frontend build vaqtida ishlatiladi)
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN.COM/api/v1

# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=maternity_user
POSTGRES_PASSWORD=           # openssl rand -base64 32
POSTGRES_DB=maternity_ward_db
DATABASE_URL=postgresql://maternity_user:POSTGRES_PASSWORD@postgres:5432/maternity_ward_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=              # openssl rand -base64 24

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=                  # node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=7d

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Hikvision ───────────────────────────────────────────────
HIKCONNECT_HOST=https://open.hikvision.com
HIKCONNECT_APP_KEY=
HIKCONNECT_APP_SECRET=
HIKVISION_WEBHOOK_SECRET=    # openssl rand -base64 32

# ─── Contact (login sahifasi) ─────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=info@maternity.uz
NEXT_PUBLIC_CONTACT_PHONE=+998901234567

# ─── Media ───────────────────────────────────────────────────
MEDIAMTX_HLS_HOST=http://localhost:8888
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Payroll ─────────────────────────────────────────────────
WEEKLY_LATE_PENALTY_THRESHOLD_MIN=120
LATE_GRACE_PERIOD_MIN=15
OVERTIME_RATE=1.5
TIMEZONE=Asia/Tashkent
