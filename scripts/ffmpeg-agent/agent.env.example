# agent.sh sozlamalari. Nusxa: cp agent.env.example agent.env
# agent.env git'ga TUSHMAYDI (.gitignore) — parollarni faqat o'sha yerda saqlang.

VPS_HOST=clinicuk24.com
VPS_RTSP_PORT=8554
HOSPITAL_ID=hospital1

# Kameralarning (DVR/NVR) login-paroli
CAM_USER=admin
CAM_PASS=

# VPS MediaMTX'ga oqim yuborish logini (serverdagi .env.prod dagi
# MEDIAMTX_PUBLISH_USER / MEDIAMTX_PUBLISH_PASS bilan bir xil)
PUBLISH_USER=
PUBLISH_PASS=

# "kamera_nomi|ip:port/yo'l" — bo'shliq bilan ajratiladi
CAMERAS_LIST="cam1|192.168.1.64:554/Streaming/Channels/101 cam2|192.168.1.65:554/Streaming/Channels/101 cam3|192.168.1.66:554/Streaming/Channels/101"
