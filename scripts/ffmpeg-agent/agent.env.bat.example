:: agent.bat sozlamalari. Nusxa: agent.env.bat.example -> agent.env.bat
:: agent.env.bat git'ga TUSHMAYDI — parollarni faqat o'sha yerda saqlang.
set VPS_HOST=clinicuk24.com
set VPS_RTSP_PORT=8554
set HOSPITAL_ID=hospital1

:: Kameralarning (DVR/NVR) login-paroli
set CAM_USER=admin
set CAM_PASS=

:: VPS MediaMTX'ga oqim yuborish logini (serverdagi MEDIAMTX_PUBLISH_USER/PASS)
set PUBLISH_USER=
set PUBLISH_PASS=

set CAM1_NAME=cam1
set CAM1_ADDR=192.168.1.64:554/Streaming/Channels/101
set CAM2_NAME=cam2
set CAM2_ADDR=192.168.1.65:554/Streaming/Channels/101
