generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  MINISTRY // Viloyat / Respublika vazirlik kuzatuvchisi
  ASSISTANT_ADMIN
  ADMIN
  DIRECTOR
  DEPARTMENT_HEAD
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum ShiftType {
  DAYTIME // 08:00 – 20:00
  NIGHTTIME // 20:00 – 08:00 (overnight)
  CUSTOM
}

enum ScheduleStatus {
  WORKING
  DAY_OFF
  SICK
  VACATION
  HOLIDAY
  MATERNITY_LEAVE
  TRAINING
  OTHER_ABSENCE
}

enum SchedulePlanningMode {
  STANDARD
  POST_COVERAGE
}

enum MonthlySchedulePlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum SchedulePlanEntryType {
  WORKING
  DAY_OFF
  SICK
  VACATION
  MATERNITY_LEAVE
  TRAINING
  OTHER_ABSENCE
}

enum ScheduleChangeType {
  SUBSTITUTION
  SWAP
  ABSENCE
}

enum ScheduleChangeStatus {
  REQUESTED
  ACCEPTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EARLY_LEAVE
  LATE_EARLY
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum PayrollAdjustmentType {
  OVERTIME_PAY
  CONTRACTUAL_KPI_BONUS
  ONE_TIME_AWARD
  DISCIPLINARY_FINE
  OTHER_LAWFUL_DEDUCTION
}

enum PayrollAdjustmentStatus {
  PENDING_EXPLANATION
  PENDING_APPROVAL
  PENDING_ACKNOWLEDGEMENT
  APPROVED
  REJECTED
  CANCELLED
  APPLIED
}

enum SalaryAdvanceStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
  APPLIED
}

enum Lang {
  uz
  ru
  en
  kaa
}

enum NotificationType {
  PAYMENT
  SYSTEM
  ALERT
  GEOFENCE_ALERT
}

enum LeaveType {
  VACATION // Yillik ta'til
  SICK // Kasallik (vaqtinchalik mehnatga layoqatsizlik)
  PERSONAL // Shaxsiy sabab
  MATERNITY // Tug'ruq ta'tili
  UNPAID // Haqsiz ta'til
}

enum LeaveStatus {
  PENDING // Kutilmoqda (direktor ko'rmagan)
  APPROVED // Tasdiqlandi
  REJECTED // Rad etildi
  CANCELLED // Xodim o'zi bekor qildi
  COMPLETED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  FIRED
}

enum PaymentType {
  MONTHLY
  ANNUAL
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum TrialLeadSource {
  WEB_FORM
  TELEGRAM_BOT
}

enum TrialLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  REJECTED
}

// ─────────────────────────────────────────────
// TERMINAL EVENT TYPES (Hikvision work status)
// ─────────────────────────────────────────────

enum TerminalEventType {
  CHECK_IN // Keldi (kirish)
  CHECK_OUT // Ketdi (chiqish)
  LUNCH_OUT // Tushlikka chiqdi
  LUNCH_IN // Tushlikdan qaytdi
  COFFEE_OUT // Coffee/tanaffusga chiqdi
  COFFEE_IN // Coffee/tanaffusdan qaytdi
  OVERTIME_IN // Qo'shimcha ishga kirdi
  OVERTIME_OUT // Qo'shimcha ishdan chiqdi
  UNKNOWN // Noma'lum / fallback
}

// Break turi (tushlik, coffee, boshqa)
enum BreakType {
  LUNCH
  COFFEE
  OTHER
}

// ─────────────────────────────────────────────
// HOSPITAL (Tug'ruq xona — tenant)
// ─────────────────────────────────────────────

model Hospital {
  id        String  @id @default(uuid())
  name      String // "1-son tug'ruq xona"
  address   String?
  phone     String?
  code      String  @unique // "TUG-01"
  logoUrl   String?
  isActive  Boolean @default(true)
  isBlocked Boolean @default(false) // Manual admin blok

  // STANDARD — mavjud poliklinika grafigi o'zgarmaydi.
  // POST_COVERAGE — tug'ruqxona uchun post kesimidagi oylik reja yoqiladi.
  schedulePlanningMode SchedulePlanningMode @default(STANDARD)

  // GPS geofencing — mobil check-in uchun (ixtiyoriy)
  gpsLat    Float? // Kasalxona kengligi
  gpsLng    Float? // Kasalxona uzunligi
  gpsRadius Int?   @default(200) // Ruxsat etilgan radius (metr)

  // Avtomatik to'lov eslatmasi (FAZA 5, 2-bosqich, 2026-09-19) — oyiga bir
  // marta yuboriladi, shu ikkita maydon spam bo'lmasligi uchun nazorat qiladi
  lastPaymentReminderAt     DateTime?
  lastPaymentReminderPeriod String? // "YYYY-MM" — shu oy uchun eslatma yuborilganmi

  users                  User[]
  employees              Employee[]
  departments            Department[]
  positions              Position[]
  shifts                 ShiftTemplate[]
  telegramSubs           TelegramSubscription[]
  notifications          Notification[]
  payments               Payment[]
  cameras                Camera[]
  hikTerminals           HikTerminal[]
  leaveRequests          LeaveRequest[]
  assistantAdmins        HospitalAssistant[]
  didoxCredential        HospitalDidoxCredential?
  payrollAdjustments     PayrollAdjustment[]
  salaryAdvances         SalaryAdvance[]
  schedulePosts          SchedulePost[]
  monthlySchedulePlans   MonthlySchedulePlan[]
  monthlyScheduleEntries MonthlyScheduleEntry[]
  scheduleChangeRequests ScheduleChangeRequest[]
  workSites              WorkSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// HOSPITAL ASSISTANT (ASSISTANT_ADMIN'ga biriktirilgan shifoxonalar)
// ─────────────────────────────────────────────
// Odiljon so'rovi (2026-09-19): "Assistant admin faqat o'ziga biriktirilgan
// korxona/poliklinikalarni ko'rishi tahrirlashi kerak". SUPER_ADMIN har bir
// ASSISTANT_ADMIN uchun qaysi shifoxonalarga ruxsat berilganini shu jadval
// orqali boshqaradi (/panel/hospitals). Agar bir ASSISTANT_ADMIN uchun
// bironta ham yozuv bo'lmasa — eski xatti-harakat saqlanadi (hammasini
// ko'radi, o'tish davri uchun, Odiljon bilan kelishilgan).
model HospitalAssistant {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, hospitalId])
}

// ─────────────────────────────────────────────
// CAMERA (HikConnect kamera — poliklinikaga bog'liq)
// ─────────────────────────────────────────────

model Camera {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name            String // "Qabul xonasi", "Koridor 1", "Kirish"
  cameraIndexCode String? // HikConnect unique camera code (keyinroq)
  channelNo       Int     @default(1)
  deviceSerial    String? // HikConnect device serial (optional)

  // MediaMTX stream path — FFmpeg agent pushes to VPS
  // e.g. "hospital1/cam1" → https://vps/hospital1/cam1/index.m3u8
  streamPath String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lang         Lang       @default(uz)

  // Email — ixtiyoriy, tasdiqlangach parolni tiklash va OTP uchun ishlatiladi
  email           String?   @unique
  emailVerifiedAt DateTime?

  // SUPER_ADMIN uchun null, boshqalari uchun majburiy
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  employee                     Employee?
  pushSubscriptions            PushSubscription[]
  liveLocations                LiveLocation[]
  notifications                Notification[]
  emailOtpTokens               EmailOtpToken[]
  passwordResetTokens          PasswordResetToken[]
  assignedHospitals            HospitalAssistant[]
  permissionOverrides          UserPermissionOverride[]
  createdPayrollAdjustments    PayrollAdjustment[]      @relation("PayrollAdjustmentCreator")
  decidedPayrollAdjustments    PayrollAdjustment[]      @relation("PayrollAdjustmentDecider")
  requestedSalaryAdvances      SalaryAdvance[]          @relation("SalaryAdvanceRequester")
  approvedSalaryAdvances       SalaryAdvance[]          @relation("SalaryAdvanceApprover")
  createdMonthlySchedulePlans  MonthlySchedulePlan[]    @relation("MonthlySchedulePlanCreator")
  approvedMonthlySchedulePlans MonthlySchedulePlan[]    @relation("MonthlySchedulePlanApprover")
  requestedScheduleChanges     ScheduleChangeRequest[]  @relation("ScheduleChangeRequester")
  acceptedScheduleChanges      ScheduleChangeRequest[]  @relation("ScheduleChangeAccepter")
  approvedScheduleChanges      ScheduleChangeRequest[]  @relation("ScheduleChangeApprover")

  lastLoginAt          DateTime? // Oxirgi muvaffaqiyatli login vaqti (auth.service.ts login()da yangilanadi)
  // Parol almashtirilsa yoki tiklansa, undan oldin berilgan barcha JWTlar
  // shu vaqt bilan solishtirib yaroqsiz qilinadi.
  credentialsChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OtpPurpose {
  EMAIL_VERIFY
}

enum ResetChannel {
  EMAIL
  TELEGRAM
  SMS
}

model EmailOtpToken {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose @default(EMAIL_VERIFY)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

model PasswordResetToken {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  channel    ResetChannel
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// PUSH SUBSCRIPTIONS (Web Push Notifications)
// ─────────────────────────────────────────────

model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique // Browser push endpoint URL
  p256dh    String // Encryption key
  auth      String // Auth secret
  userAgent String? // Browser info

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// DEPARTMENTS
// ─────────────────────────────────────────────

model Department {
  id          String  @id @default(uuid())
  name        String
  description String?
  code        String

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  employees     Employee[]
  schedulePosts SchedulePost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
}

// ─────────────────────────────────────────────
// POSITIONS
// ─────────────────────────────────────────────

model Position {
  id   String @id @default(uuid())
  name String

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  employees Employee[]

  // Maktab hamshirasi uchun GPS geofence (ixtiyoriy)
  gpsLat    Float?
  gpsLng    Float?
  gpsRadius Int?   @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, name])
}

// ─────────────────────────────────────────────
// EMPLOYEES
// ─────────────────────────────────────────────

model Employee {
  id String @id @default(uuid())

  // Hikvision terminal ID — rasm yuklananda auto-generate bo'ladi
  // null bo'lishi mumkin (hali enroll qilinmagan)
  employeeNo String? @unique

  fullName   String
  gender     Gender
  phone      String?
  email      String?
  photoUrl   String?
  baseSalary Decimal @db.Decimal(12, 2)

  gpsLat    Float?
  gpsLng    Float?
  gpsRadius Int?   @default(100)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  telegramChatId String?

  // HR botga (davomat xabarlari/hisobotlari) ulanish ruxsati. Direktor,
  // o'rinbosari, kadrlar boshlig'i kabi 3-5 shaxsga Direktor/Admin/
  // Super Admin tomonidan beriladi. Ulanish Telegram "raqamni ulashish"
  // (contact) orqali — raqam egasi Telegram tomonidan tasdiqlanadi.
  telegramBotAccess Boolean                @default(false)
  telegramSubs      TelegramSubscription[]

  // Qo'shimcha ish joylari (maktab, bog'cha, filial...) — check-in shu
  // joylarning istalganida (va muassasa asosiy binosida) ruxsat etiladi.
  workSites EmployeeWorkSite[]

  hiredAt    DateTime       @default(now())
  firedAt    DateTime?
  fireReason String? // Ketish sababi: RESIGNED, FIRED, RETIRED, TRANSFERRED, OTHER
  fireNote   String? // Qo'shimcha izoh
  birthDate  DateTime?
  status     EmployeeStatus @default(ACTIVE)

  schedules                  Schedule[]
  attendances                AttendanceRecord[]
  payrolls                   PayrollRecord[]
  weeklyStats                WeeklyAttendanceStat[]
  terminalEvents             AttendanceEvent[]
  leaveRequests              LeaveRequest[]
  payrollAdjustments         PayrollAdjustment[]
  salaryAdvances             SalaryAdvance[]
  monthlyScheduleEntries     MonthlyScheduleEntry[]
  replacementScheduleChanges ScheduleChangeRequest[] @relation("ScheduleChangeReplacementEmployee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([hospitalId, firedAt])
}

// ─────────────────────────────────────────────
// SHIFT TEMPLATES
// ─────────────────────────────────────────────

model ShiftTemplate {
  id          String    @id @default(uuid())
  name        String
  type        ShiftType
  startTime   String
  endTime     String
  isOvernight Boolean   @default(false)
  durationH   Int

  graceMinutes Int @default(15)

  // Tushlik vaqti (ixtiyoriy)
  lunchStart    String? // "12:00"
  lunchEnd      String? // "13:00"
  lunchGraceMin Int     @default(10) // tushlikdan qaytishda grace period

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  schedules              Schedule[]
  monthlyScheduleEntries MonthlyScheduleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, name])
}

// ─────────────────────────────────────────────
// SCHEDULES
// ─────────────────────────────────────────────

model Schedule {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  shiftId String?
  shift   ShiftTemplate? @relation(fields: [shiftId], references: [id])

  date   DateTime
  status ScheduleStatus @default(WORKING)
  note   String?

  // POST_COVERAGE rejasidan nashr qilingan grafiklar uchun audit manbasi.
  // Eski STANDARD grafiklarda bu maydonlar null bo'lib qoladi.
  sourcePlanId            String?
  sourceEntryId           String?
  scheduleChangeRequestId String?

  attendance AttendanceRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([sourcePlanId])
  @@index([scheduleChangeRequestId])
}

// ─────────────────────────────────────────────
// POST-BASED MONTHLY SCHEDULE PLANNING (opt-in per hospital)
// ─────────────────────────────────────────────

model SchedulePost {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name                 String
  code                 String
  dailyCoverageMinutes Int     @default(1440)
  isActive             Boolean @default(true)

  plans MonthlySchedulePlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId, departmentId, isActive])
}

model MonthlySchedulePlan {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  postId String
  post   SchedulePost @relation(fields: [postId], references: [id], onDelete: Restrict)

  year    Int
  month   Int
  version Int                       @default(1)
  status  MonthlySchedulePlanStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("MonthlySchedulePlanCreator", fields: [createdById], references: [id], onDelete: Restrict)

  submittedAt DateTime?

  approvedById String?
  approvedBy   User?     @relation("MonthlySchedulePlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  decisionNote String?

  entries        MonthlyScheduleEntry[]
  changeRequests ScheduleChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, year, month, version])
  @@index([hospitalId, year, month, status])
}

model MonthlyScheduleEntry {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  planId String
  plan   MonthlySchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  shiftId String?
  shift   ShiftTemplate? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  entryType SchedulePlanEntryType @default(WORKING)
  workDate  DateTime
  startsAt  DateTime?
  endsAt    DateTime?
  note      String?

  primaryChangeRequests     ScheduleChangeRequest[] @relation("ScheduleChangePrimaryEntry")
  counterpartChangeRequests ScheduleChangeRequest[] @relation("ScheduleChangeCounterpartEntry")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, employeeId, workDate])
  @@index([hospitalId, workDate])
}

model ScheduleChangeRequest {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  planId String
  plan   MonthlySchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  type             ScheduleChangeType
  status           ScheduleChangeStatus   @default(REQUESTED)
  absenceEntryType SchedulePlanEntryType?

  primaryEntryId String
  primaryEntry   MonthlyScheduleEntry @relation("ScheduleChangePrimaryEntry", fields: [primaryEntryId], references: [id], onDelete: Restrict)

  counterpartEntryId String?
  counterpartEntry   MonthlyScheduleEntry? @relation("ScheduleChangeCounterpartEntry", fields: [counterpartEntryId], references: [id], onDelete: SetNull)

  replacementEmployeeId String?
  replacementEmployee   Employee? @relation("ScheduleChangeReplacementEmployee", fields: [replacementEmployeeId], references: [id], onDelete: SetNull)

  reason String

  requestedById String
  requestedBy   User   @relation("ScheduleChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  acceptedById String?
  acceptedBy   User?     @relation("ScheduleChangeAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("ScheduleChangeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, status, createdAt])
  @@index([planId, status])
  @@index([replacementEmployeeId, status])
}

// ─────────────────────────────────────────────
// ATTENDANCE RECORDS
// ─────────────────────────────────────────────

model AttendanceRecord {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  scheduleId String?   @unique
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  deviceId        String?
  rawCheckInTime  DateTime?
  rawCheckOutTime DateTime?

  checkIn          DateTime?
  checkOut         DateTime?
  expectedCheckIn  DateTime
  expectedCheckOut DateTime

  // Tushlik break (ixtiyoriy)
  lunchOut     DateTime?
  lunchIn      DateTime?
  lunchLateMin Int       @default(0)

  // Coffee / tanaffus break (ixtiyoriy)
  coffeeOut     DateTime?
  coffeeIn      DateTime?
  coffeeLateMin Int       @default(0)

  // Mobil self check-in ma'lumotlari
  checkInSource String? @default("TERMINAL") // TERMINAL | MOBILE | MANUAL
  selfieUrl     String? // Check-in selfie rasmi yo'li
  gpsLat        Float? // Check-in paytidagi koordinata
  gpsLng        Float?
  gpsAccuracy   Float? // GPS aniqligi (metr)
  gpsVerified   Boolean @default(false)
  faceVerified  Boolean @default(false)

  // Mobil check-in qaysi ish joyida qilingani (null — asosiy bino, eski
  // shaxsiy/lavozim markazi yoki markaz belgilanmagan).
  checkInWorkSiteId String?
  checkInWorkSite   WorkSite? @relation(fields: [checkInWorkSiteId], references: [id], onDelete: SetNull)

  // Check-out selfie + GPS (mobil ilovadan)
  checkOutSource      String? // TERMINAL | MOBILE | MANUAL | AUTO
  autoCheckOut        Boolean @default(false)
  checkOutSelfieUrl   String?
  checkOutGpsLat      Float?
  checkOutGpsLng      Float?
  checkOutGpsAccuracy Float?

  status          AttendanceStatus @default(ABSENT)
  lateMinutes     Int              @default(0)
  earlyLeaveMin   Int              @default(0)
  overtimeMinutes Int              @default(0)

  // Sof ish vaqti (tushlik ayirib tashlangan) — maosh hisoblash uchun
  netWorkMin Int @default(0)

  workDate DateTime
  note     String?

  // Terminal eventlari (audit trail)
  terminalEvents AttendanceEvent[]
  breaks         BreakRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, workDate])
  @@index([employeeId, workDate])
}

// ─────────────────────────────────────────────
// WORK SITES — muassasaning qo'shimcha ish joylari (2026-09-23, FAZA 6 4b)
// Poliklinika xodimlari maktab, bog'cha, harbiy komissariat, sport zal va
// boshqa joylarga yo'naltiriladi. Har bir joyning o'z geofence'i bor;
// xodimga bir nechta joy biriktiriladi. Faqat DIRECTOR/ADMIN boshqaradi.
// ─────────────────────────────────────────────

model WorkSite {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  gpsLat    Float
  gpsLng    Float
  gpsRadius Int     @default(200)
  isActive  Boolean @default(true)

  employees   EmployeeWorkSite[]
  attendances AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, isActive])
}

model EmployeeWorkSite {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSiteId String
  workSite   WorkSite @relation(fields: [workSiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([employeeId, workSiteId])
  @@index([workSiteId])
}

// ─────────────────────────────────────────────
// WEEKLY ATTENDANCE STAT
// ─────────────────────────────────────────────

model WeeklyAttendanceStat {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  weekStart DateTime
  weekEnd   DateTime

  totalLateMin  Int @default(0)
  totalEarlyMin Int @default(0)
  totalOvertime Int @default(0)
  daysWorked    Int @default(0)
  daysAbsent    Int @default(0)

  penaltyLateMin  Int     @default(0)
  deductionAmount Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, weekStart])
}

// ─────────────────────────────────────────────
// PAYROLL
// ─────────────────────────────────────────────

model PayrollRecord {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  month Int
  year  Int

  baseSalary       Decimal @db.Decimal(12, 2)
  totalWorkDays    Int     @default(0)
  totalAbsences    Int     @default(0)
  totalLateMin     Int     @default(0)
  totalEarlyMin    Int     @default(0)
  totalOvertimeMin Int     @default(0)
  totalNetWorkMin  Int     @default(0)

  absenceDeduction    Decimal @default(0) @db.Decimal(12, 2)
  lateDeduction       Decimal @default(0) @db.Decimal(12, 2)
  earlyLeaveDeduction Decimal @default(0) @db.Decimal(12, 2)

  overtimeBonus   Decimal @default(0) @db.Decimal(12, 2)
  manualBonus     Decimal @default(0) @db.Decimal(12, 2)
  manualDeduction Decimal @default(0) @db.Decimal(12, 2)

  contractualKpiBonus  Decimal @default(0) @db.Decimal(12, 2)
  oneTimeAward         Decimal @default(0) @db.Decimal(12, 2)
  disciplinaryFine     Decimal @default(0) @db.Decimal(12, 2)
  otherLawfulDeduction Decimal @default(0) @db.Decimal(12, 2)
  deferredDeduction    Decimal @default(0) @db.Decimal(12, 2)
  advancePaid          Decimal @default(0) @db.Decimal(12, 2)
  advanceApplied       Decimal @default(0) @db.Decimal(12, 2)
  deferredAdvance      Decimal @default(0) @db.Decimal(12, 2)
  grossSalary          Decimal @default(0) @db.Decimal(12, 2)

  netSalary Decimal       @db.Decimal(12, 2)
  status    PayrollStatus @default(DRAFT)
  note      String?

  adjustments PayrollAdjustment[]
  advances    SalaryAdvance[]

  approvedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([month, year])
}

// KPI/mukofot va qonuniy ushlanmalar davomat faktidan alohida yuritiladi.
model PayrollAdjustment {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  payrollRecordId String?
  payrollRecord   PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  month  Int
  year   Int
  type   PayrollAdjustmentType
  status PayrollAdjustmentStatus @default(PENDING_APPROVAL)

  proposedAmount  Decimal  @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)
  reason          String
  policyReference String?
  evidence        Json?

  explanationRequestedAt DateTime?
  employeeExplanation    String?
  explanationSubmittedAt DateTime?
  explanationRefusedAt   DateTime?

  orderNumber    String?
  orderDate      DateTime?
  acknowledgedAt DateTime?

  calculationBaseAmount Decimal? @db.Decimal(12, 2)
  finePercent           Decimal? @db.Decimal(5, 2)

  createdById    String
  createdBy      User      @relation("PayrollAdjustmentCreator", fields: [createdById], references: [id])
  decidedById    String?
  decidedBy      User?     @relation("PayrollAdjustmentDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, year, month])
  @@index([employeeId, year, month])
  @@index([status])
}

// Ish haqi hisobiga oldindan to'langan bo'nak; jarima yoki qarz emas.
model SalaryAdvance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  payrollRecordId String?
  payrollRecord   PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  month            Int
  year             Int
  status           SalaryAdvanceStatus @default(REQUESTED)
  requestedAmount  Decimal             @db.Decimal(12, 2)
  approvedAmount   Decimal?            @db.Decimal(12, 2)
  paidAmount       Decimal?            @db.Decimal(12, 2)
  note             String?
  paymentReference String?

  requestedById String
  requestedBy   User      @relation("SalaryAdvanceRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("SalaryAdvanceApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, year, month])
  @@index([employeeId, year, month])
  @@index([status])
}

// ─────────────────────────────────────────────
// SYSTEM SETTINGS (global yoki hospital-level)
// ─────────────────────────────────────────────

model SystemSettings {
  id    String @id @default(uuid())
  key   String
  value String

  // null = global sozlama, set = hospital-specific
  hospitalId String?

  updatedAt DateTime @updatedAt

  @@unique([key, hospitalId])
}

// Global, durable state for critical infrastructure monitoring. Keeping this
// in PostgreSQL prevents duplicate alerts while two backend replicas overlap
// during a rolling deploy.
model OperationalServiceMonitor {
  serviceKey          String    @id
  status              String    @default("HEALTHY")
  consecutiveFailures Int       @default(0)
  outageStartedAt     DateTime?
  alertedAt           DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  updatedAt           DateTime  @updatedAt
}

model TrialLead {
  id               String          @id @default(uuid())
  source           TrialLeadSource
  status           TrialLeadStatus @default(NEW)
  institutionName  String
  contactName      String
  phone            String
  orgType          String?
  region           String?
  staffCount       Int?
  plan             String?
  billingCycle     String?
  faceId           Boolean?
  contactTime      String?
  telegramChatId   String?
  telegramUsername String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  pageUrl          String?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([phone])
}

// ─────────────────────────────────────────────
// TELEGRAM SUBSCRIPTIONS
// ─────────────────────────────────────────────

model TelegramSubscription {
  id       String   @id @default(uuid())
  chatId   String
  username String?
  role     UserRole @default(DIRECTOR)
  isActive Boolean  @default(true)

  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  // Qaysi ruxsatli xodim ulangan (contact orqali tasdiqlangan). Eski
  // (2026-09-23 gacha, raqamni matn bilan yozib ulangan) obunalarda null.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatId, hospitalId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  hospitalId String?
  action     String
  entity     String
  entityId   String?
  details    Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS (in-app, SUPER_ADMIN uchun)
// ─────────────────────────────────────────────

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType @default(PAYMENT)
  title   String
  message String
  isRead  Boolean          @default(false)

  // Shaxsiy xabar (masalan: "ta'tilingiz tasdiqlandi") — set bo'lsa, faqat shu user ko'radi
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Broadcast xabar (masalan: "yangi ta'til so'rovi") — userId=null, hospitalId=set bo'lsa,
  // shu kasalxonadagi tegishli userlar (DIRECTOR/ADMIN va h.k.) ko'radi.
  // userId=null va hospitalId=null bo'lsa — global (SUPER_ADMIN) broadcast.
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([hospitalId, isRead])
  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// ATTENDANCE EVENTS (terminal raw log — o'zgarmas)
// Har bir terminal signali bu yerga yoziladi.
// AttendanceRecord computed natija, bu esa audit trail.
// ─────────────────────────────────────────────

model AttendanceEvent {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Qaysi AttendanceRecord ga bog'landi (null = ignore qilindi yoki hali bog'lanmagan)
  recordId String?
  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  eventType  TerminalEventType
  deviceId   String?
  deviceName String?

  // Terminal dan kelgan aniq vaqt (UTC)
  rawTime DateTime

  // Hikvision dan kelgan to'liq payload — debug uchun
  rawPayload Json?

  createdAt DateTime @default(now())

  @@index([employeeId, rawTime])
  @@index([recordId])
}

// ─────────────────────────────────────────────
// BREAK RECORDS (tushlik, coffee — har bir break)
// AttendanceRecord ga bog'langan, bir kunda bir nechta bo'lishi mumkin
// ─────────────────────────────────────────────

model BreakRecord {
  id String @id @default(uuid())

  recordId String
  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  type      BreakType
  startTime DateTime
  endTime   DateTime?
  lateMin   Int       @default(0) // qaytishda kechikish minutlari

  createdAt DateTime @default(now())

  @@index([recordId])
}

// ─────────────────────────────────────────────
// PAYMENTS (kasalxona to'lovlari)
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  hospitalId        String
  hospital          Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  payerName         String
  amount            Decimal       @db.Decimal(12, 2)
  type              PaymentType   @default(MONTHLY)
  period            String? // "2026-03" — YYYY-MM
  status            PaymentStatus @default(PAID)
  paidAt            DateTime      @default(now())
  note              String?
  // Telegram to'lov uchun qo'shimcha fieldlar
  employeeCount     Int? // To'lov vaqtidagi xodimlar soni
  validUntil        DateTime? // Obuna tugash sanasi
  telegramPaymentId String? // Telegram charge_id
  paidByChatId      String? // Kim to'ladi (chatId)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([hospitalId, period])
  @@index([hospitalId, validUntil])
}

// ─────────────────────────────────────────────
// LEAVE REQUESTS (Ta'til / Kasallik so'rovlari)
// ─────────────────────────────────────────────

model LeaveRequest {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  type      LeaveType @default(VACATION)
  startDate DateTime // Boshlanish sanasi (UTC midnight)
  endDate   DateTime // Tugash sanasi (UTC midnight)
  daysCount Int       @default(1) // Kalendar kunlar soni
  reason    String? // Sababni izohlash (ixtiyoriy)

  status LeaveStatus @default(PENDING)

  reviewedBy String? // User.id — kim tasdiqladi/rad etdi
  reviewNote String? // Direktor izohi
  reviewedAt DateTime?

  documentUrl String? // Kasallik uchun hujjat (fayl)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([hospitalId, status])
  @@index([employeeId, startDate, endDate])
}

model HikTerminal {
  id                 String    @id @default(uuid())
  name               String // "Kirish terminali"
  devIndex           String    @unique // Gateway UUID
  hospitalId         String
  password           String?
  hospital           Hospital  @relation(fields: [hospitalId], references: [id])
  isActive           Boolean   @default(true)
  lastSeenAt         DateTime? // Gateway oxirgi marta online ko'rsatgan vaqt
  offlineSince       DateTime? // Uzluksiz offline holat boshlangan vaqt
  lastOfflineAlertAt DateTime? // Shu uzilish uchun ogohlantirish yuborilgan vaqt
  createdAt          DateTime  @default(now())
}

model LiveLocation {
  id        String   @id @default(uuid())
  userId    String
  latitude  Float
  longitude Float
  accuracy  Float
  speed     Float?
  battery   Int?
  isOutside Boolean? // Geofence tashqarisidami — direktor ogohlantirishi uchun
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// GRANULAR RUXSATLAR (FAZA 5, 7-bosqich, 2026-09-19)
// Mavjud rol (@Roles) tizimini almashtirmaydi — ustiga qo'shimcha qatlam.
// Bo'sh bo'lsa (hech qanday override yo'q) — hamma narsa rol standarti
// bo'yicha ishlaydi (bugungidek). Faqat standart holatdan FARQ qiladigan
// yozuvlar shu yerda saqlanadi (masalan "bitta Director uchun
// payroll.approve = false").
// ─────────────────────────────────────────────
model UserPermissionOverride {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String // masalan "payroll.view", "payments.edit" — src/common/permissions.ts dagi katalogga mos
  granted    Boolean // true = standartdan tashqari ruxsat berilgan, false = standartdan tortib olingan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}

// ─────────────────────────────────────────────
// DIDOX (elektron hujjat aylanish tizimi) — ЭЦП orqali autentifikatsiya
// ─────────────────────────────────────────────
// StaffPulse rejasi, "O'zbekiston bozoriga mos integratsiyalar" bandi
// (2026-09-20). MUHIM: bu yerda mijozning ЭЦП PRIVATE KALITI HECH QACHON
// saqlanmaydi — imzolash accountant kompyuterida E-IMZO ID lokal agenti
// orqali brauzerda amalga oshiriladi, bizning serverimiz faqat NATIJA
// (pkcs7 imzo va undan olingan token)ni qabul qiladi/saqlaydi.
model HospitalDidoxCredential {
  id         String   @id @default(uuid())
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  serialNumber   String // ЭЦП kalitining seriya raqami (shifoxona buxgalteri/rahbari)
  authToken      String? // Didox'dan olingan bearer token
  tokenExpiresAt DateTime? // authToken muddati (odatda 24 soat)
  lastAuthId     String? // eng oxirgi olingan authId (challenge bosqichi uchun)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
